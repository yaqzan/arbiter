# Copy to .env (gitignored) and fill in what applies to you. Every line is
# optional; environment variables with the same names win over this file.

# Where the server listens. 127.0.0.1 keeps it on this machine.
ARBITER_HOST=127.0.0.1
ARBITER_PORT=5002

# Who can change things. Anyone can read; only a request from a Tailscale peer
# (100.64.0.0/10) can write. serve also listens on this machine's tailnet address
# when Tailscale is running. 0 turns that off and makes the whole app read only.
# ARBITER_TRUST_TAILNET=1
# ARBITER_TAILSCALE_IP=          # only if `tailscale ip -4` can't be run
#
# ARBITER_OPEN=1 lets every caller write, for local development. It is NOT read
# from this file on purpose: set it in your shell for one run, and never on a
# server with a public tunnel.

# Shown in the serve banner if you publish it somewhere (tunnel, reverse proxy).
# ARBITER_PUBLIC_ORIGIN=https://arbiter.example.com

# Your library lives here (default: data/ in the repo).
# ARBITER_DATA_DIR=
# ARBITER_DB=

# Plex. The database path defaults to where Plex Media Server keeps it on
# Windows, macOS or Linux. On Windows the token is read from the registry once
# you are signed in to Plex; elsewhere set it here.
# ARBITER_PLEX_DB=
# ARBITER_PLEX_TOKEN=

# Obsidian media log (one note per title, star rating in the frontmatter).
# ARBITER_OBSIDIAN_VAULT=C:\path\to\vault\Media
# ARBITER_OBSIDIAN_OVERRIDES=data/obsidian-overrides.json

# Radarr / Sonarr for the "on disk" badge. Off unless both URL and key are set.
# They can run on another machine: use whatever address this server can reach.
# ARBITER_RADARR_URL=http://192.168.1.20:7878
# ARBITER_RADARR_KEY=
# ARBITER_SONARR_URL=http://192.168.1.20:8989
# ARBITER_SONARR_KEY=
# Or point at a JSON file shaped {"radarr": {"api_key": "..."}, "sonarr": {...}}
# ARBITER_ARR_SECRETS=
